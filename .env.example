# Copie para .env; substitua a senha local por uma senha aleatória. Nunca comite .env.
DATABASE_URL=postgresql://offgrid:SUBSTITUA_POR_SENHA_ALEATORIA@127.0.0.1:5432/offgrid
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Recuperação por e-mail: opcional no desenvolvimento, necessária antes do uso real.
# SMTP_URL=smtps://usuario:senha@seu-servidor:465
# MAIL_FROM=OFFGRID <workspace@sua-empresa.com.br>
# Somente para o comando admin:create; não mantenha a senha exportada após executar.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
