{
  "name": "offgrid-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/generate-client.cjs",
    "db:deploy": "node scripts/migrate.cjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "format": "prettier --write src tests scripts docs *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts docs *.ts *.json *.md"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
